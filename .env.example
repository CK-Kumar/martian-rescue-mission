# Copy this file to .env and fill in real keys: cp .env.example .env
# .env is gitignored; this example file is safe to commit (no real keys).

# OpenAI (critic) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic / Claude Haiku (solver) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# xAI / Grok (solver) — https://console.x.ai
XAI_API_KEY=xai-...

# Qwen on your RunPod vLLM server (solver). Fill in when the pod is running:
# the URL is the pod's port 8000 link (Connect tab) plus /v1.
VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# The proxy URL is public, so vLLM must be started with --api-key; use the
# same string here and in the pod's VLLM_API_KEY variable.
VLLM_API_KEY=random-string-from-openssl-rand-hex-16
